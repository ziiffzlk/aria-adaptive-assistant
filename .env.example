# Copy this file to ".env" and fill in your own values.
# Get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# TTS engine: "chatterbox" (GPU, expressive) or "kokoro" (offline ONNX, default)
ARIA_TTS_ENGINE=kokoro

# Set to 1 once models are downloaded to skip HuggingFace network checks at startup
HF_HUB_OFFLINE=1
